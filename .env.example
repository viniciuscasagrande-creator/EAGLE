# Configuração de Ambiente — Portal do Produtor DiskIngressos

# URL base do Keeper Core API
# Em desenvolvimento local: utilize '/api/v1' (com proxy do vite para http://localhost:4000)
# Em produção: informe a URL pública oficial da API Keeper (ex: https://api.diskingressos.com.br/api/v1 ou https://keeper-tng6.vercel.app/api/v1)
VITE_KEEPER_API_URL=/api/v1

# Porta do servidor local (padrão 3001 para não colidir com o Keeper na 3000)
PORT=3001
